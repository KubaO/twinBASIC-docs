' SortingTests: the generic sort of dates, and FindTag with the StartsWith match.
[TestFixture]
Module SortingTests

    Private Function SortedColumn(ByVal f As HostForm, ByVal Mode As FlexSortConstants, ParamArray Values() As Variant) As String
        Dim i As Long
        With f.Grid
            .FixedRows = 0: .FixedCols = 0
            .Rows = UBound(Values) + 1: .Cols = 1
            For i = 0 To UBound(Values)
                .TextMatrix(i, 0) = Values(i)
            Next
            .SelectRange 0, 0, 0, 0
            .Sort = Mode
            For i = 0 To UBound(Values)
                SortedColumn = SortedColumn & IIf(i > 0, " ", "") & .TextMatrix(i, 0)
            Next
        End With
    End Function

    [TestCase]
    Public Sub Sort_GenericAscending_ComparesDatesAsText()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.AreEqual "1/10/2026 1/9/2026", SortedColumn(f, FlexSortGenericAscending, "1/9/2026", "1/10/2026"), "the column 1/9/2026, 1/10/2026 after a generic ascending sort"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Sort_DateAscending_ComparesDates()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.AreEqual "1/9/2026 1/10/2026", SortedColumn(f, FlexSortDateAscending, "1/10/2026", "1/9/2026"), "the column 1/10/2026, 1/9/2026 after a date ascending sort"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Sort_GenericAscending_NumbersAreComparedAsNumbers()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.AreEqual "2 9 10 100", SortedColumn(f, FlexSortGenericAscending, "10", "9", "100", "2"), "the column 10, 9, 100, 2 after a generic ascending sort"
        Unload f
        Expect.Done
    End Sub

    Private Sub TagGrid(ByVal f As HostForm)
        With f.Grid
            .FixedRows = 1: .FixedCols = 0
            .Rows = 2: .Cols = 3
            .Cell(FlexCellTag, 1, 1) = "t1"
            .Cell(FlexCellTag, 1, 2) = "t2"
        End With
    End Sub

    [TestCase]
    Public Sub FindTag_StartsWith_Down()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        TagGrid f
        Expect.AreEqual 1, f.Grid.FindTag("t", 1, 1, FlexFindMatchStartsWith), "FindTag of the start t down from cell (1,1)"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindTag_StartsWith_Right()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        TagGrid f
        Expect.AreEqual 1, f.Grid.FindTag("t", 1, 1, FlexFindMatchStartsWith, , , , FlexFindDirectionRight), "FindTag of the start t to the right from cell (1,1)"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindTag_StartsWith_Left()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        TagGrid f
        Expect.AreEqual 2, f.Grid.FindTag("t", 1, 2, FlexFindMatchStartsWith, , , , FlexFindDirectionLeft), "FindTag of the start t to the left from cell (1,2)"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindTag_StartsWith_Right_IgnoresTheTagOfTheControl()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        TagGrid f
        f.Grid.Tag = "t2"
        Expect.AreEqual -1, f.Grid.FindTag("zzz", 1, 1, FlexFindMatchStartsWith, , , , FlexFindDirectionRight), "FindTag of the start zzz to the right from cell (1,1) when the control's Tag is t2"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindTag_Partial_Right()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        TagGrid f
        Expect.AreEqual 2, f.Grid.FindTag("2", 1, 1, FlexFindMatchPartial, , , , FlexFindDirectionRight), "FindTag of the part 2 to the right from cell (1,1)"
        Unload f
        Expect.Done
    End Sub

End Module
