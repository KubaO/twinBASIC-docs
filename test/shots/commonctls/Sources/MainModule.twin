Module MainModule

    ' The program behind the WinNativeCommonCtls section's pictures of a running program
    ' (scripts/shoot_docs.mjs, setup commonctls). Its command line names the scene: which
    ' controls the form shows and how they are set. TB_SHOT_SIGNALS, when it is set, names a
    ' folder through which the tool and the program take turns: the program writes "shown" once
    ' its form is drawn and in the state the picture shows, and ends when "end" appears or the
    ' form is closed. The texts are the fixture's own, and every date is the fixed one below, the
    ' calendars' today included: nothing is read from the machine.
    '
    ' frmScene holds hidden controls of each class, which a scene places and shows. Every scene
    ' lays its form out in pixels at 96 DPI (FitClient), so that it looks the same at any DPI.

    Private Declare PtrSafe Sub Sleep Lib "kernel32" (ByVal Milliseconds As Long)
    Private Declare PtrSafe Function SetForegroundWindow Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function GetForegroundWindow Lib "user32" () As LongPtr
    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, _
        ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Declare PtrSafe Function PostMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, _
        ByVal wParam As LongPtr, ByVal lParam As LongPtr) As Long
    Private Const WM_NCACTIVATE As Long = &H86
    Private Const WM_KEYDOWN As Long = &H100
    Private Const VK_F4 As Long = &H73
    Private Const WM_TIMER As Long = &H113
    ' The ticks a progress bar's timers are given before its picture is taken.
    Private Const TICKS As Long = 30
    Private Const MCM_SETTODAY As Long = &H100C
    Private Declare PtrSafe Function InvalidateRect Lib "user32" (ByVal hWnd As LongPtr, ByVal lpRect As LongPtr, ByVal bErase As Long) As Long
    Private Declare PtrSafe Function KillTimer Lib "user32" (ByVal hWnd As LongPtr, ByVal nIDEvent As LongPtr) As Long
    Private Const DTM_GETMONTHCAL As Long = &H1008

    Private Type SYSTEMTIME
        wYear As Integer
        wMonth As Integer
        wDayOfWeek As Integer
        wDay As Integer
        wHour As Integer
        wMinute As Integer
        wSecond As Integer
        wMilliseconds As Integer
    End Type

    ' The date every scene shows, and the calendars' today.
    Private Const THE_DATE As Date = #1/14/2025 3:45:00 PM#
    Private Const MASK_SILVER As Long = &HC0C0C0

    ' The scene's date picker whose calendar is shown dropped down, or Nothing.
    Private Dropped As DTPicker
    ' The progress bars' timers that StillBars stopped, each Array(hWnd, id).
    Private BarTimers As New Collection
    Private Doing As String

    Public Sub Main()
        ' Command$ is the command line as written, quotes included
        Dim scene As String = LCase$(Trim$(Replace(Command$, """", "")))
        Dim f As Form = frmScene
        Load f
        On Error GoTo Failed
        f.AutoRedraw = True
        f.ForeColor = vbBlack
        Doing = "images"
        FillImages f
        Doing = "set up"
        SetUp scene, f
        f.Show
        Activate f
        f.Refresh
        DoEvents
        Doing = "after show"
        AfterShow scene, f
        f.Refresh
        DoEvents
        Sleep 200
        DoEvents
    Shown:
        On Error GoTo 0
        Signal "shown"
        If WaitFor("end", f) Then Unload f
        Exit Sub
    Failed:
        ' The tool fails the picture with this text, rather than wait for a form that never shows.
        Signal "error", "error " & Err.Number & " in " & scene & " (" & Doing & "): " & Err.Description
        f.Show
        Resume Shown
    End Sub

    Private Sub SetUp(ByVal scene As String, ByVal f As Form)
        Select Case scene
            Case "listview": ListViews f
            Case "treeview": TreeStyles f
            Case "treelines": TreeLines f
            Case "treeborders": TreeBorders f
            Case "progressbar": ProgressBars f
            Case "slider": Sliders f
            Case "monthview": MonthViews f
            Case "dtpicker": DTPickers f
            Case "imagelist": ImageLists f
            Case "overview": Overview f
            Case Else: Err.Raise 5, , "no scene named " & scene
        End Select
    End Sub

    ' What needs the window on screen: the calendar dropped down, the calendars' today.
    Private Sub AfterShow(ByVal scene As String, ByVal f As Form)
        Select Case scene
            Case "monthview", "overview": PinToday frmScene.mv0.hWnd
        End Select
        Select Case scene
            Case "progressbar", "overview": StillBars f
        End Select
        KeepDropped
    End Sub

    ' ---------------------------------------------------------------- the image lists

    ' The image lists of every scene, under the same keys: Windows' stock icons, large in
    ' imlLarge and small in imlSmall, and in imlMasked (ColorDepth24Bit) the same large pictures
    ' as bitmaps on the default MaskColor, silver.
    Private Sub FillImages(ByVal f As Form)
        Dim keys As Variant = Array("folder", "doc", "picture", "music", "zip", "app", "pc", "drive")
        Dim ids As Variant = Array(SIID_FOLDER, SIID_DOCASSOC, SIID_IMAGEFILES, SIID_AUDIOFILES, SIID_ZIPFILE, _
            SIID_APPLICATION, SIID_DESKTOPPC, SIID_DRIVEFIXED)
        frmScene.imlMasked.ColorDepth = ColorDepth24Bit
        Dim i As Long
        For i = 0 To UBound(keys)
            frmScene.imlLarge.ListImages.Add , keys(i), StockIcon(ids(i), False)
            frmScene.imlMasked.ListImages.Add , keys(i), StockBitmap(ids(i), MASK_SILVER)
            frmScene.imlSmall.ListImages.Add , keys(i), StockIcon(ids(i), True)
        Next
    End Sub

    ' ---------------------------------------------------------------- ListView

    ' The four View values, each a ListView of the same six items. Each list is filled once it
    ' is visible: filled while hidden, it shows none of its items in lvwIcon (BETA 1042).
    Private Sub ListViews(ByVal f As Form)
        f.Caption = "ListView"
        FitClient f, 2 * 310 + 10, 2 * 200 + 10
        Dim names As Variant = Array("lvwIcon (0)", "lvwSmallIcon (1)", "lvwList (2)", "lvwReport (3)")
        Dim i As Long
        For i = 0 To 3
            Dim x As Single = 10 + (i Mod 2) * 310
            Dim y As Single = 6 + (i \ 2) * 200
            Text f, names(i), x, y
            Dim lv As ListView = f.Controls("lv" & i)
            lv.Move x, y + 20, 300, 170
            lv.View = i
            lv.Visible = True
            FillList lv
        Next
    End Sub

    Private Sub FillList(ByVal lv As ListView)
        Doing = "ListView " & lv.Name
        lv.TabStop = False
        Set lv.Icons = frmScene.imlLarge
        Set lv.SmallIcons = frmScene.imlSmall
        lv.ColumnHeaders.Add , "name", "Name", 130
        lv.ColumnHeaders.Add , "type", "Type", 100
        lv.ColumnHeaders.Add , "size", "Size", 60, lvwColumnRight
        Dim names As Variant = Array("Documents", "Report.docx", "Holiday.jpg", "Song.mp3", "Archive.zip", "Setup.exe")
        Dim keys As Variant = Array("folder", "doc", "picture", "music", "zip", "app")
        Dim types As Variant = Array("File folder", "Document", "Picture", "Audio", "Archive", "Application")
        Dim sizes As Variant = Array("", "24 KB", "1.2 MB", "3.4 MB", "640 KB", "2.1 MB")
        Dim i As Long
        For i = 0 To 5
            Dim item As ListItem = lv.ListItems.Add(, "i" & i, names(i), keys(i), keys(i))
            item.SubItems(1) = types(i)
            item.SubItems(2) = sizes(i)
        Next
    End Sub

    ' ---------------------------------------------------------------- TreeView

    ' The eight Style values, each a TreeView of the same nodes.
    Private Sub TreeStyles(ByVal f As Form)
        f.Caption = "TreeView Style"
        FitClient f, 4 * 200 + 10, 2 * 166 + 6
        Dim names As Variant = Array("tvwTextOnly", "tvwPictureText", "tvwPlusMinusText", "tvwPlusMinusPictureText", _
            "tvwTreelinesText", "tvwTreelinesPictureText", "tvwTreelinesPlusMinusText", "tvwTreelinesPlusMinusPictureText")
        Dim i As Long
        For i = 0 To 7
            Dim x As Single = 10 + (i Mod 4) * 200
            Dim y As Single = 6 + (i \ 4) * 166
            Text f, names(i) & " (" & i & ")", x, y
            Dim tv As TreeView = f.Controls("tv" & i)
            tv.Move x, y + 20, 190, 136
            FillTree tv
            tv.Style = i
            tv.Visible = True
        Next
    End Sub

    ' LineStyle's two values, each a TreeView with lines, buttons and pictures.
    Private Sub TreeLines(ByVal f As Form)
        f.Caption = "TreeView LineStyle"
        FitClient f, 2 * 200 + 10, 166
        Dim names As Variant = Array("tvwTreeLines (0)", "tvwRootLines (1)")
        Dim i As Long
        For i = 0 To 1
            Dim x As Single = 10 + i * 200
            Text f, names(i), x, 6
            Dim tv As TreeView = f.Controls("tv" & i)
            tv.Move x, 26, 190, 136
            FillTree tv
            tv.Style = tvwTreelinesPlusMinusPictureText
            tv.LineStyle = i
            tv.Visible = True
        Next
    End Sub

    ' BorderStyle's two values, ccFixedSingle with each Appearance.
    Private Sub TreeBorders(ByVal f As Form)
        f.Caption = "TreeView BorderStyle"
        FitClient f, 3 * 200 + 10, 186
        Dim names As Variant = Array("ccNone (0)", "ccFixedSingle (1)", "ccFixedSingle (1)")
        Dim appearances As Variant = Array("", "vbAppear3d", "vbAppearFlat")
        Dim i As Long
        For i = 0 To 2
            Dim x As Single = 10 + i * 200
            Text f, names(i), x, 6
            If i > 0 Then Text f, "Appearance = " & appearances(i), x, 24
            Dim tv As TreeView = f.Controls("tv" & i)
            tv.Move x, 46, 190, 132
            FillTree tv
            tv.BorderStyle = IIf(i = 0, ccNone, ccFixedSingle)
            tv.Appearance = IIf(i = 2, vbAppearFlat, vbAppear3d)
            tv.Visible = True
        Next
    End Sub

    ' Documents (expanded), holding Letters (expanded, holding a document) and a picture, and
    ' Music, collapsed, holding a song.
    Private Sub FillTree(ByVal tv As TreeView)
        Doing = "TreeView " & tv.Name
        tv.TabStop = False
        Set tv.ImageList = frmScene.imlSmall
        Dim docs As Node = tv.Nodes.Add(, , "docs", "Documents", "folder")
        Dim letters As Node = tv.Nodes.Add(docs, tvwChild, "letters", "Letters", "folder")
        tv.Nodes.Add letters, tvwChild, "report", "Report.docx", "doc"
        tv.Nodes.Add docs, tvwChild, "holiday", "Holiday.jpg", "picture"
        Dim music As Node = tv.Nodes.Add(, , "music", "Music", "folder")
        tv.Nodes.Add music, tvwChild, "song", "Song.mp3", "music"
        letters.Expanded = True
        docs.Expanded = True
    End Sub

    ' ---------------------------------------------------------------- ProgressBar

    ' Horizontal bars in each State and Scrolling, two drawn without visual styles and one with
    ' a border, and three vertical bars.
    Private Sub ProgressBars(ByVal f As Form)
        f.Caption = "ProgressBar"
        FitClient f, 640, 8 * 30 + 12
        Dim names As Variant = Array("PrbStateNormal (1)", "PrbStateError (2)", "PrbStatePaused (3)", _
            "PrbScrollingSmooth (1)", "PrbScrollingMarquee (2)", "VisualStyles = False", _
            "VisualStyles = False, Smooth, colours", "BorderStyle = vbFixedSingle")
        Dim i As Long
        For i = 0 To 7
            Dim y As Single = 10 + i * 30
            Text f, names(i), 10, y + 1
            Dim p As ProgressBar = f.Controls("pb" & i)
            Doing = "ProgressBar " & p.Name
            p.Move 250, y, 240, 20
            p.Value = 60
            Select Case i
                Case 1: p.State = PrbStateError
                Case 2: p.State = PrbStatePaused
                Case 3: p.Scrolling = PrbScrollingSmooth
                Case 4
                    ' StillBars starts the marquee
                    p.Scrolling = PrbScrollingMarquee
                Case 5: p.VisualStyles = False
                Case 6
                    p.VisualStyles = False
                    p.Scrolling = PrbScrollingSmooth
                    p.ForeColor = RGB(30, 80, 160)
                    p.BackColor = RGB(214, 228, 248)
                Case 7: p.BorderStyle = vbFixedSingle
            End Select
            p.Visible = True
        Next
        Dim states As Variant = Array(PrbStateNormal, PrbStateError, PrbStatePaused)
        Dim values As Variant = Array(30, 60, 90)
        Text f, "PrbOrientationVertical", 495, 10, 140
        For i = 0 To 2
            Dim v As ProgressBar = f.Controls("pb" & (8 + i))
            Doing = "ProgressBar " & v.Name
            v.Orientation = PrbOrientationVertical
            v.Move 530 + i * 26, 34, 18, 214
            v.State = states(i)
            v.Value = values(i)
            v.Visible = True
        Next
    End Sub

    ' The bars still: a progress bar drawn with visual styles animates its bar (its growth to a
    ' new value, the marquee's block, and a light that runs along a bar in the normal state) with
    ' timers of its own window, and a picture needs a still frame. Once the bars have grown to
    ' their values, and before the light first runs, the marquee is started and every timer
    ' stopped; the marquee's is then given its tick a number of times (where its block ends up
    ' still depends on the time the ticks take, by a few pixels).
    Private Sub StillBars(ByVal f As Form)
        Dim t As Single = Timer
        Do While Timer - t < 0.6
            DoEvents
            Sleep 20
        Loop
        Dim c As Object
        For Each c In f.Controls
            If TypeOf c Is ProgressBar Then
                If c.Visible Then
                    Dim marquee As Boolean = c.Scrolling = PrbScrollingMarquee
                    If marquee Then c.MarqueeAnimation = True
                    Dim id As Long, k As Long
                    For id = 0 To 1000
                        If KillTimer(c.hWnd, id) Then
                            BarTimers.Add Array(c.hWnd, id)
                            If marquee Then
                                For k = 1 To TICKS
                                    SendMessageW c.hWnd, WM_TIMER, id, 0
                                Next
                            End If
                        End If
                    Next
                End If
            End If
        Next
    End Sub

    ' The bars' timers stopped again while the form waits: without it, a bar moved again once
    ' the tool had the program's window, and no two of its captures were equal.
    Private Sub KeepStill()
        Dim t As Variant
        For Each t In BarTimers
            KillTimer t(0), t(1)
        Next
    End Sub

    ' ---------------------------------------------------------------- Slider

    ' Horizontal sliders with each TickStyle, a selection range and no thumb, and two vertical
    ' ones; each runs from 0 to 10 with its thumb at 4.
    Private Sub Sliders(ByVal f As Form)
        f.Caption = "Slider"
        FitClient f, 620, 6 * 46 + 14
        Dim names As Variant = Array("sldBottomRight (0)", "sldTopLeft (1)", "sldBoth (2)", "sldNoTicks (3)", _
            "SelectRange, SelStart 3, SelLength 4", "HideThumb = True")
        Dim i As Long
        For i = 0 To 5
            Dim y As Single = 10 + i * 46
            Text f, names(i), 10, y + 10
            Dim s As Slider = f.Controls("sl" & i)
            Doing = "Slider " & s.Name
            SetSlider s
            s.Move 250, y, 240, 40
            Select Case i
                Case 0 To 3: s.TickStyle = i
                Case 4
                    s.SelectRange = True
                    s.SelStart = 3
                    s.SelLength = 4
                Case 5: s.HideThumb = True
            End Select
            s.Visible = True
        Next
        Text f, "ccOrientationVertical", 485, 10, 130
        For i = 0 To 1
            Dim v As Slider = f.Controls("sl" & (6 + i))
            Doing = "Slider " & v.Name
            SetSlider v
            v.Orientation = ccOrientationVertical
            v.TickStyle = IIf(i = 0, sldBottomRight, sldBoth)
            v.Move 510 + i * 40, 34, 40, 240
            v.Visible = True
        Next
    End Sub

    Private Sub SetSlider(ByVal s As Slider)
        s.TabStop = False
        s.Min = 0
        s.Max = 10
        s.TickFrequency = 1
        s.Value = 4
    End Sub

    ' ---------------------------------------------------------------- MonthView and DTPicker

    ' Two months side by side, with week numbers and four days selected; frmScene's GetDayBold
    ' handler puts three days in bold.
    Private Sub MonthViews(ByVal f As Form)
        f.Caption = "MonthView"
        FitClient f, 800, 400
        Dim m As MonthView = frmScene.mv0
        SetMonthView m, 2
        m.Move 10, 10
        m.Visible = True
        FitClient f, m.Width + 20, m.Height + 20
    End Sub

    Private Sub SetMonthView(ByVal m As MonthView, ByVal Columns As Long)
        Doing = "MonthView"
        m.TabStop = False
        m.MonthColumns = Columns
        m.MonthRows = 1
        m.ShowWeekNumbers = True
        m.MultiSelect = True
        m.MaxSelCount = 7
        m.Value = DateValue(THE_DATE)
        m.SelStart = DateValue(THE_DATE)
        m.SelEnd = DateAdd("d", 3, DateValue(THE_DATE))
    End Sub

    ' The four Format values, the spin buttons and the check box, and a short date with its
    ' calendar dropped down.
    Private Sub DTPickers(ByVal f As Form)
        f.Caption = "DTPicker"
        FitClient f, 560, 6 * 36 + 8
        Dim names As Variant = Array("dtpLongDate (0)", "dtpTime (2)", "dtpCustom (3)", "UpDown = True", _
            "CheckBox = True", "dtpShortDate (1), dropped down")
        Dim i As Long
        For i = 0 To 5
            Dim y As Single = 10 + i * 36
            Text f, names(i), 10, y + 3
            Dim d As DTPicker = f.Controls("dt" & i)
            Doing = "DTPicker " & d.Name
            d.TabStop = False
            d.Move 250, y, 300, 26
            Select Case i
                Case 0: d.Format = dtpLongDate
                Case 1: d.Format = dtpTime
                Case 2
                    d.Format = dtpCustom
                    d.CustomFormat = "dddd d MMMM yyyy 'at' h:mm tt"
                Case 3
                    d.Format = dtpShortDate
                    d.UpDown = True
                Case 4
                    d.Format = dtpShortDate
                    d.CheckBox = True
                Case 5
                    d.Format = dtpShortDate
                    Set Dropped = d
            End Select
            d.Value = THE_DATE
            d.Visible = True
        Next
    End Sub

    ' The scene's date picker with its calendar dropped down (F4), again whenever it has
    ' closed (it closes when the form is made the active window), and the calendar's today
    ' the scene's date.
    Private Sub KeepDropped()
        If Dropped Is Nothing Then Exit Sub
        If SendMessageW(Dropped.hWnd, DTM_GETMONTHCAL, 0, 0) <> 0 Then Exit Sub
        PostMessageW Dropped.hWnd, WM_KEYDOWN, VK_F4, 0
        Dim i As Long
        For i = 1 To 40
            DoEvents
            Dim cal As LongPtr = SendMessageW(Dropped.hWnd, DTM_GETMONTHCAL, 0, 0)
            If cal <> 0 Then
                PinToday cal
                Exit Sub
            End If
            Sleep 25
        Next
    End Sub

    ' A month calendar's today set to the scene's date, or the picture would change every day.
    Private Sub PinToday(ByVal hWnd As LongPtr)
        Dim t As SYSTEMTIME
        t.wYear = Year(THE_DATE)
        t.wMonth = Month(THE_DATE)
        t.wDay = Day(THE_DATE)
        t.wDayOfWeek = Weekday(THE_DATE) - 1
        SendMessageW hWnd, MCM_SETTODAY, 0, VarPtr(t)
        InvalidateRect hWnd, 0, 1
    End Sub

    ' ---------------------------------------------------------------- ImageList

    ' One picture drawn with ListImage.Draw in each Style, and with UseBackColor, on a
    ' chequered ground, so that what each draws of the ground shows: from an image list of the
    ' default ColorDepth32Bit, whose pictures carry their transparency in an alpha channel, and
    ' from one of ColorDepth24Bit, whose pictures have a mask.
    Private Sub ImageLists(ByVal f As Form)
        f.Caption = "ImageList Draw"
        f.BackColor = vbWhite
        Dim names As Variant = Array("ImlDrawNormal", "ImlDrawTransparent", "ImlDrawSelected", "ImlDrawFocus", _
            "ImlDrawNoMask", "ImlDrawNormal")
        Dim values As Variant = Array("(1)", "(2)", "(4)", "(8)", "(16)", "(1), UseBackColor")
        Dim styles As Variant = Array(WinNativeCommonCtls.ImlDrawNormal, WinNativeCommonCtls.ImlDrawTransparent, _
            WinNativeCommonCtls.ImlDrawSelected, WinNativeCommonCtls.ImlDrawFocus, WinNativeCommonCtls.ImlDrawNoMask, _
            WinNativeCommonCtls.ImlDrawNormal)
        Dim depths As Variant = Array("ColorDepth32Bit", "ColorDepth24Bit")
        Const COL As Single = 124
        Const LEFT_ As Single = 130
        FitClient f, LEFT_ + 6 * COL + 10, 50 + 2 * 66
        Dim i As Long, r As Long
        For i = 0 To 5
            Text f, names(i), LEFT_ + i * COL, 6, COL
            Text f, values(i), LEFT_ + i * COL, 24, COL
        Next
        For r = 0 To 1
            Dim il As ImageList = IIf(r = 0, frmScene.imlLarge, frmScene.imlMasked)
            Dim y As Single = 50 + r * 66
            Text f, depths(r), 10, y + 15
            For i = 0 To 5
                Dim x As Single = LEFT_ + i * COL
                Chequer f, x + (COL - 48) / 2, y, 48
                If i = 5 Then
                    il.BackColor = RGB(255, 220, 120)
                    il.UseBackColor = True
                End If
                Doing = "Draw " & depths(r) & " " & names(i)
                ' ImageWidth and ImageHeight are device pixels
                il.ListImages("picture").Draw f.hDC, (x + COL / 2) * Dpi() - il.ImageWidth / 2, _
                    (y + 24) * Dpi() - il.ImageHeight / 2, styles(i)
            Next
            il.UseBackColor = False
        Next
    End Sub

    ' A square Size pixels wide of grey and white squares 8 pixels wide.
    Private Sub Chequer(ByVal f As Form, ByVal x As Single, ByVal y As Single, ByVal Size As Single)
        Dim r As Long, c As Long
        For r = 0 To Size \ 8 - 1
            For c = 0 To Size \ 8 - 1
                f.Line (x + c * 8, y + r * 8)-(x + c * 8 + 7, y + r * 8 + 7), IIf((r + c) Mod 2, RGB(200, 200, 200), vbWhite), BF
            Next
        Next
    End Sub

    ' ---------------------------------------------------------------- all the controls

    ' A form of the seven visible controls, as a program uses them: a TreeView of folders, a
    ' ListView of files, a MonthView, a DTPicker, an UpDown beside a text box, a Slider and a
    ' ProgressBar. (The ImageList, which holds the pictures, is not visible at run time.)
    Private Sub Overview(ByVal f As Form)
        f.Caption = "WinNativeCommonCtls"
        FitClient f, 800, 600
        Dim tv As TreeView = frmScene.tv0
        tv.Move 10, 10, 190, 200
        FillTree tv
        tv.Visible = True
        Dim lv As ListView = frmScene.lv0
        lv.Move 210, 10, 300, 200
        lv.View = lvwReport
        lv.Visible = True
        FillList lv
        Dim m As MonthView = frmScene.mv0
        SetMonthView m, 1
        m.ShowWeekNumbers = False
        m.Move 10, 222
        m.Visible = True
        Dim x As Single = m.Width + 30
        Dim y As Single = 226
        Text f, "Due date", x, y + 3
        Dim d As DTPicker = frmScene.dt0
        d.TabStop = False
        d.Format = dtpShortDate
        d.Value = THE_DATE
        d.Move x + 80, y, 140, 26
        d.Visible = True
        y += 40
        Text f, "Copies", x, y + 3
        Dim t As TextBox = frmScene.txtCount
        t.TabStop = False
        t.Move x + 80, y, 40, 24
        t.Text = "3"
        t.Visible = True
        Dim u As UpDown = frmScene.ud0
        u.Orientation = ccOrientationVertical
        u.Min = 1
        u.Max = 99
        u.Value = 3
        u.Move x + 120, y, 18, 24
        u.Visible = True
        y += 40
        Text f, "Volume", x, y + 8
        Dim s As Slider = frmScene.sl0
        SetSlider s
        s.Value = 7
        s.Move x + 74, y, 220, 36
        s.Visible = True
        y += 50
        Text f, "Copying", x, y + 1
        Dim p As ProgressBar = frmScene.pb0
        p.Value = 45
        p.Move x + 80, y, 210, 20
        p.Visible = True
        FitClient f, Max(lv.Left + lv.Width, p.Left + p.Width) + 10, Max(m.Top + m.Height, p.Top + p.Height) + 10
    End Sub

    Private Function Max(ByVal a As Single, ByVal b As Single) As Single
        Return IIf(a > b, a, b)
    End Function

    ' ---------------------------------------------------------------- helpers

    ' The form's client area made Width by Height pixels at 96 DPI, and its scale those pixels.
    Private Sub FitClient(ByVal f As Form, ByVal Width As Single, ByVal Height As Single)
        f.ScaleMode = vbTwips
        f.Width = f.Width + (Width * 15 - f.ScaleWidth)
        f.Height = f.Height + (Height * 15 - f.ScaleHeight)
        f.Scale (0, 0)-(Width, Height)
    End Sub

    ' Device pixels to a pixel at 96 DPI.
    Private Function Dpi() As Single
        Return 15 / Screen.TwipsPerPixelX
    End Function

    ' Text printed on the form at (x, y), centred in a column Width wide when Width is given.
    Private Sub Text(ByVal f As Form, ByVal s As String, ByVal x As Single, ByVal y As Single, Optional ByVal Width As Single = 0)
        f.CurrentX = IIf(Width > 0, x + (Width - f.TextWidth(s)) / 2, x)
        f.CurrentY = y
        f.Print s
    End Sub

    ' Makes the form the active window, as it is when a person starts the program. On the
    ' tool's private desktop, which has no input, the foreground is not dependable, so while
    ' the form waits it draws its frame as the active window's whenever it is not the
    ' foreground window.
    Private Sub Activate(ByVal f As Form)
        SetForegroundWindow f.hWnd
        DoEvents
        KeepActive f
    End Sub

    Private Sub KeepActive(ByVal f As Form)
        If f.Visible And GetForegroundWindow() <> f.hWnd Then SendMessageW f.hWnd, WM_NCACTIVATE, 1, 0
    End Sub

    ' The folder of the signals, or "" when no tool runs the program.
    Private Function Signals() As String
        Return Environ$("TB_SHOT_SIGNALS")
    End Function

    Private Sub Signal(ByVal Name As String, Optional ByVal Text As String)
        If Len(Signals()) = 0 Then Exit Sub
        Dim n As Integer = FreeFile
        Open Signals() & "\" & Name For Output As #n
        If Len(Text) Then Print #n, Text
        Close #n
    End Sub

    ' Waits until the signal is there (True), or until the form is closed (False).
    Private Function WaitFor(ByVal Name As String, ByVal f As Form) As Boolean
        Do
            If Len(Signals()) Then
                If Len(Dir$(Signals() & "\" & Name)) Then Return True
            End If
            If Not IsLoaded(f) Then Return False
            KeepActive f
            KeepDropped
            KeepStill
            DoEvents
            Sleep 50
        Loop
    End Function

    Private Function IsLoaded(ByVal f As Form) As Boolean
        Dim g As Object
        For Each g In Forms
            If g Is f Then Return True
        Next
        Return False
    End Function

End Module
