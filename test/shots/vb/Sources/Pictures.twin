Module Pictures

    ' The pictures the scenes put on graphical buttons, made in code so that the fixture
    ' carries no image file: Windows' stock icons, at 16 or 32 pixels.

    Private Type PICTDESC
        cbSizeofstruct As Long
        picType As Long
        hImage As LongPtr
        hPal As LongPtr
    End Type

    Private Type GUID
        Data1 As Long
        Data2 As Integer
        Data3 As Integer
        Data4(0 To 7) As Byte
    End Type

    Private Declare PtrSafe Function OleCreatePictureIndirect Lib "oleaut32" (ByRef Desc As PICTDESC, _
        ByRef riid As GUID, ByVal fOwn As Long, ByRef Pic As IPicture) As Long
    Private Type SHSTOCKICONINFO
        cbSize As Long
        hIcon As LongPtr
        iSysImageIndex As Long
        iIcon As Long
        szPath(0 To 519) As Byte
    End Type

    Private Declare PtrSafe Function SHGetStockIconInfo Lib "shell32" (ByVal siid As Long, ByVal uFlags As Long, _
        ByRef psii As SHSTOCKICONINFO) As Long

    Private Const PICTYPE_ICON As Long = 3
    Private Const SHGSI_ICON As Long = &H100&
    Private Const SHGSI_SMALLICON As Long = &H1&

    Public Const SIID_DOCNOASSOC As Long = 0
    Public Const SIID_WARNING As Long = 78
    Public Const SIID_INFO As Long = 79
    Public Const SIID_HELP As Long = 23
    Public Const SIID_FOLDER As Long = 3
    Public Const SIID_FOLDEROPEN As Long = 4

    Private Function IID_IPicture() As GUID
        Dim g As GUID
        g.Data1 = &H7BF80980
        g.Data2 = &HBF32
        g.Data3 = &H101A
        g.Data4(0) = &H8B: g.Data4(1) = &HBB: g.Data4(2) = &H0: g.Data4(3) = &HAA
        g.Data4(4) = &H0: g.Data4(5) = &H30: g.Data4(6) = &HC: g.Data4(7) = &HAB
        Return g
    End Function

    ' A Windows stock icon, 16 by 16 pixels when Small, else 32 by 32, owned by the picture.
    Public Function StockIcon(ByVal Id As Long, Optional ByVal Small As Boolean = True) As StdPicture
        Dim info As SHSTOCKICONINFO
        info.cbSize = LenB(info)
        If SHGetStockIconInfo(Id, SHGSI_ICON Or IIf(Small, SHGSI_SMALLICON, 0), info) <> 0 Then
            Err.Raise 5, , "SHGetStockIconInfo failed for icon " & Id
        End If
        Dim d As PICTDESC
        d.cbSizeofstruct = LenB(d)
        d.picType = PICTYPE_ICON
        d.hImage = info.hIcon
        Dim p As IPicture
        OleCreatePictureIndirect d, IID_IPicture(), 1, p
        Return p
    End Function

End Module
