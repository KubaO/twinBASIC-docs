[Description("")]
[FormDesignerId("6DD63D9A-6D89-4DF6-A103-F48524549100")]
Class frmSlider

    ' WaynesSlider's picture: sliders in their default look, from 0 to 100 with a Value of 40,
    ' with each DisplayFormat; and one whose Direction is Vertical.

    Private Sub tmrScene_Timer()
        If Shots.Tick(Me) Then Me.Close
    End Sub

    Public Sub SetUp()
        Dim names As Variant = Array("DisplayValue (0)", "DisplayPercentage (1)", "DisplayNone (2)")
        Dim i As Long
        For i = 0 To 2
            Dim l As WaynesLabel = Shots.Ctl(Me, "lblSlider" & i)
            l.Caption = names(i)
            l.TextRendering.Font.Size = 10
            l.TextRendering.Alignment = tbAlignMiddleLeft
            Dim s As WaynesSlider = Shots.Ctl(Me, "sldFormat" & i)
            SetSlider s
            s.DisplayFormat = i
        Next
        lblVertical.Caption = "Vertical"
        lblVertical.TextRendering.Font.Size = 10
        SetSlider sldVertical
        sldVertical.Direction = SliderDirection.Vertical
    End Sub

    Private Sub SetSlider(ByVal s As WaynesSlider)
        Shots.Defaults s
        s.MinValue = 0
        s.MaxValue = 100
        s.Value = 40
    End Sub

End Class
