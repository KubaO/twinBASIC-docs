' A form of the CustomControls package (a WaynesForm) holding six green WaynesLabels, each 80 x 60
' pixels: L1 to L5 in a row at the top (Left 20, 130, 240, 350, 460; Top 40), and L6 below L1
' (Top 220). Change gives
' each one a new value of one property: in the constructor for the first form Sub Main shows, and
' once shown for the second. Its timer then reports what is drawn and closes the form.
[Description("")]
[FormDesignerId("5C1E7A40-2B9D-4F63-8E15-A0D4C7B2E901")]
Class Form1

    Sub New()
        If Startup.InNew Then Change
    End Sub

    Private Sub Change()
        L1.Left = 60
        L2.Top = 140
        L3.Width = 100
        L4.Height = 120
        L5.Visible = False
        L6.Dock = tbDockRight
    End Sub

    Private Ticks As Long

    Private Sub Timer1_Timer()
        Ticks += 1
        If Ticks = 3 And Not Startup.InNew Then Change
        If Ticks = 6 Then
            Startup.Report Me
            Me.Close
        End If
    End Sub

End Class
